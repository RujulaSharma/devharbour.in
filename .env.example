# Dev Harbour Environment Configuration
PORT=3000
NODE_ENV=development

# Session & Security
SESSION_SECRET=devharbour_super_secret_session_key_change_in_production
TOKEN_EXPIRY_DAYS=7

# Database (Default uses built-in SQLite database at ./devharbour.sqlite)
# For Supabase / PostgreSQL deployment:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# External Code Execution (Optional - default uses built-in safe Node VM sandbox)
# JUDGE0_API_KEY=your_rapidapi_judge0_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Dev Harbour Environment Configuration
PORT=3000
NODE_ENV=development

# Session & Security
SESSION_SECRET=devharbour_super_secret_session_key_change_in_production
TOKEN_EXPIRY_DAYS=7

# Runtime database: PostgreSQL through Prisma. No migrations run on startup.
DB_PROVIDER=postgresql
# Optional offline fallback (explicit opt-in): DB_PROVIDER=sqlite
# DB_PATH=.local/development.sqlite

# External Code Execution (Optional - default uses built-in safe Node VM sandbox)
# JUDGE0_API_KEY=your_rapidapi_judge0_key
# JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Prisma 7: runtime connection (use your exact Supabase Connect URI).
# Session pooler port 5432 works for this long-running local server.
DATABASE_URL=""
# CLI/migrations: direct or session pooler port 5432; never transaction port 6543.
DIRECT_URL=""

# Optional server-only Redis cache. Generate local credentials with:
# node scripts/setup-redis.js
# Leave blank to run without Redis. Never use a NEXT_PUBLIC_ prefix for secrets.
REDIS_URL=""
REDIS_CACHE_TTL_SECONDS=300

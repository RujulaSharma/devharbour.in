# Dev Harbour Environment Configuration
PORT=3000
NODE_ENV=development

# Session & Security
TOKEN_EXPIRY_DAYS=7

# Runtime database: PostgreSQL through Prisma. No migrations run on startup.
DB_PROVIDER=postgresql
# Optional offline fallback (explicit opt-in): DB_PROVIDER=sqlite
# DB_PATH=.local/development.sqlite

# Code execution requires Docker and the digest-pinned Node image.
# Pull the exact image documented in SECURITY-SETUP.md. No unsafe fallback is used.

# Prisma 7: private restricted runtime connection (devharbour_runtime).
# Shared pooler username is ROLE.PROJECT_REF; use verify-full and sslrootcert.
# Session pooler port 5432 works for this long-running local server.
DATABASE_URL=""
# Administrative CLI/migrations connection: direct or session port 5432.
# Keep separate from the restricted runtime role; use only for approved maintenance.
DIRECT_URL=""

# Optional server-only Redis cache. Generate local credentials with:
# node scripts/setup-redis.js
# Leave blank to run without Redis. Never use a NEXT_PUBLIC_ prefix for secrets.
REDIS_URL=""
REDIS_CACHE_TTL_SECONDS=300

# Optional additional trusted browser origins (comma separated, exact scheme + host).
# Same-origin requests work without this. Never use a wildcard.
APP_ORIGINS=""
# Set only behind a known reverse proxy; leave empty for local development.
TRUST_PROXY_HOPS=""

# Server-only email verification. Sending-only Resend key for your verified domain.
RESEND_API_KEY=""
EMAIL_FROM="DevHarbour <verify@auth.devharbour.in>"
APP_BASE_URL="http://localhost:3000"
# Generate locally with node scripts/setup-email-verification.js (never commit).
EMAIL_VERIFICATION_SECRET=""

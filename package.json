{
  "name": "devharbour",
  "version": "1.0.0",
  "description": "Dev Harbour — Full-Stack Developer Learning, Competing and Project Platform",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "node --test tests/api.test.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node scripts/check-supabase.js",
    "test:postgres": "node scripts/test-postgres.js",
    "redis:setup": "node scripts/setup-redis.js",
    "redis:check": "node scripts/check-redis.js",
    "cache:invalidate-courses": "node scripts/invalidate-course-cache.js",
    "test:redis": "node scripts/test-redis.js",
    "build": "node scripts/build-homepage.js",
    "build:vercel": "prisma generate && npm run build",
    "typecheck": "tsc -p tsconfig.homepage.json",
    "lint": "eslint frontend/homepage",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:homepage": "playwright test",
    "test:security": "node --test tests/security.test.js tests/execution-security.test.js",
    "test:security:browser": "playwright test -c playwright.security.config.js",
    "test:email": "node --test tests/email-verification.test.js",
    "email:check": "node scripts/check-email-verification.js",
    "db:security": "node scripts/check-runtime-security.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RujulaSharma/devharbour.in.git"
  },
  "author": "Dev Harbour Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-three/fiber": "9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "8.7.1",
    "framer-motion": "14.7.1",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.0",
    "three": "0.175.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.175.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
